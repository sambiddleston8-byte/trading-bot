# Optional live-data connectors. Leave a value blank until you have a key.
# Copy this file to .env; .env is excluded from Git.
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=

# Alpaca practice account only. Live Alpaca credentials are unsupported.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_API_BASE_URL=https://paper-api.alpaca.markets

# Local PostgreSQL only. Choose a unique password and never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
